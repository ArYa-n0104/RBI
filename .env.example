# Run the backend from the repository root.
TAARR_OBLIGATIONS_PATH=data/obligations/obligations.jsonl
TAARR_BENCHMARK_PATH=data/benchmark/benchmark.jsonl

# D-001 is finalized: emit Not applicable when no version is in force.
# The missing-facts and unknown-precedence settings remain explicit policy choices;
# see docs/DECISIONS.md before labeling edge cases or creating gold benchmark labels.
TAARR_NO_VERSION_POLICY=NOT_APPLICABLE
TAARR_MISSING_FACTS_POLICY=KLEENE
TAARR_UNKNOWN_PRECEDENCE_POLICY=DEFINITIVE_RULES_FIRST

TAARR_CORS_ORIGINS=http://localhost:5173

# ---- Gemini (only used by "Autofill the answers" and the "AI cross-check" tab) ----
# Put your key and model here. This file is re-read on every click, so after
# changing the model you just save and click again -- no restart needed.
# Copy this file to .env (git-ignored) -- never commit a real key.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model IDs listed on ai.google.dev/models (October 2026). Use the exact ID.
#   gemini-3.5-flash-lite   recommended for this app (fast, cheap, minimal thinking)
#   gemini-3.1-flash-lite
#   gemini-3.6-flash
#   gemini-3.8-flash
#   gemini-2.5-flash-lite   (only for keys that already used it)
#   gemini-2.5-flash        (only for keys that already used it)
# Not valid: gemini-3.1-flash (no such model); gemini-2.0-flash and
# gemini-2.0-flash-lite (shut down). gemini-4-argon is not on the free tier.
# Each click makes exactly ONE request, whichever model you choose.
GEMINI_MODEL=gemini-3.5-flash-lite
