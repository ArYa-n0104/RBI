# Run the backend from the repository root.
TAARR_OBLIGATIONS_PATH=data/obligations/obligations.jsonl
TAARR_BENCHMARK_PATH=data/benchmark/benchmark.jsonl

# Provisional LOCAL-DEVELOPMENT settings so the UI can be exercised.
# These are not final research/legal decisions. Review docs/DECISIONS.md
# and version the policy decision before creating gold benchmark labels.
TAARR_NO_VERSION_POLICY=NOT_APPLICABLE
TAARR_MISSING_FACTS_POLICY=KLEENE
TAARR_UNKNOWN_PRECEDENCE_POLICY=DEFINITIVE_RULES_FIRST

TAARR_CORS_ORIGINS=http://localhost:5173
