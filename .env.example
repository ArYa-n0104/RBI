# Run the backend from the repository root.
TAARR_OBLIGATIONS_PATH=data/obligations/obligations.jsonl
TAARR_BENCHMARK_PATH=data/benchmark/benchmark.jsonl

# D-001 is finalized: emit Not applicable when no version is in force.
# The missing-facts and unknown-precedence settings remain explicit policy choices;
# see docs/DECISIONS.md before labeling edge cases or creating gold benchmark labels.
TAARR_NO_VERSION_POLICY=NOT_APPLICABLE
TAARR_MISSING_FACTS_POLICY=KLEENE
TAARR_UNKNOWN_PRECEDENCE_POLICY=DEFINITIVE_RULES_FIRST

TAARR_CORS_ORIGINS=http://localhost:5173

# Optional: needed for "Autofill the answers" and the "AI cross-check" tab.
# Get a free key at https://aistudio.google.com/app/apikey
# If set here, the app works without typing a key each time.
# Copy this file to .env, which is git-ignored -- never commit a real key.
GEMINI_API_KEY=

# Which Gemini model to call. Change this and restart the backend if the model
# you are using hits its free-tier rate limit. Known working values:
#   gemini-2.5-flash-lite   (default: cheapest, highest free-tier limits)
#   gemini-2.5-flash
#   gemini-2.0-flash
#   gemini-2.0-flash-lite
# Leave blank to use the default.
GEMINI_MODEL=gemini-2.5-flash-lite
