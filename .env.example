# Run the backend from the repository root. All three resolver choices are deliberately
# required because the Build Plan and Review Paper differ on these semantics.
TAARR_OBLIGATIONS_PATH=data/obligations/obligations.jsonl
TAARR_BENCHMARK_PATH=data/benchmark/benchmark.jsonl

# Required before POST /api/v1/query or POST /api/v1/benchmark/run will resolve.
# TAARR_NO_VERSION_POLICY=DROP or NOT_APPLICABLE
# TAARR_MISSING_FACTS_POLICY=STRICT_MISSING or KLEENE
# TAARR_UNKNOWN_PRECEDENCE_POLICY=INDETERMINATE_FIRST or DEFINITIVE_RULES_FIRST

TAARR_CORS_ORIGINS=http://localhost:5173
